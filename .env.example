# Copy this to .env and fill in real values before running
# docker compose up, or `go run ./cmd/server` locally.

APP_PORT=8080

# Local dev (go run) DSN — for docker-compose this is built
# automatically from POSTGRES_PASSWORD instead, see docker-compose.yml
DATABASE_URL=postgres://journalflow:changeme@localhost:5432/journalflow?sslmode=disable

# Any long random string — used to... (currently reserved for future
# cookie-signing; sessions are DB-backed today, see internal/session)
SESSION_SECRET=replace-with-a-long-random-string

# Used by docker-compose to set the postgres container's password
POSTGRES_PASSWORD=changeme

# Point this at your self-hosted Claude endpoint if it speaks the
# Anthropic /v1/messages API shape, otherwise leave as the default
# to call api.anthropic.com directly.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
